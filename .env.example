# API Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values
# docker compose will automatically load .env

# ─── AI / RCA Agent ──────────────────────────────────────────────────────────
# Get a free Groq API key at: https://console.groq.com
GROQ_API_KEY=

# LLM provider: groq | ollama | none
# - groq: Uses Groq cloud API (fastest, free tier, requires GROQ_API_KEY)
# - ollama: Uses local Ollama (no API key, model must be pulled locally)
# - none: Disables AI RCA (platform still works, just no AI analysis)
LLM_PROVIDER=groq

# If using Ollama locally (docker compose will try host.docker.internal):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.1

# ─── Service URLs (for scenario scripts run on host, not in Docker) ──────────
# Only needed when running scenario scripts locally (not in docker compose)
GATEWAY_URL=http://localhost:3000
TEST_API_URL=http://localhost:3001
ANALYTICS_URL=http://localhost:3002
